# ==========================================================================
#  Variables de entorno del FRONTEND (SST SaaS - React + Vite)
# ==========================================================================
#  El frontend NO necesita variables de entorno para funcionar en local.
#  La URL del backend está fijada en: src/api/client.js
#      export const API_BASE_URL = "http://localhost:8000";
#
#  Si algún día el backend corre en otra dirección (ej. un servidor remoto),
#  cambia ese valor en src/api/client.js, o adapta el código para leer de
#  import.meta.env.VITE_API_BASE_URL y define la variable aquí abajo.
# ==========================================================================

# Ejemplo (actualmente NO se usa; requiere ajustar client.js para leerla):
# VITE_API_BASE_URL=http://localhost:8000

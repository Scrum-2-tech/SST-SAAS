# ==========================================================================
#  Variables de entorno del BACKEND (SST SaaS)
# ==========================================================================
#  Copia este archivo como ".env" (sin .example) y ajusta si hace falta.
#  Para desarrollo LOCAL puedes dejar estos valores tal cual: coinciden con
#  los del docker-compose.yml, así arranca sin tocar nada.
#
#  IMPORTANTE (producción): en un servidor real cambia SECRET_KEY por una
#  cadena larga y aleatoria, y usa una contraseña de base de datos fuerte.
# ==========================================================================

# --- Base de datos PostgreSQL ---
# Formato: postgresql://usuario:password@host:puerto/basededatos
# 'postgres' / 'tu_clave_secreta_aqui' / 'sst_db' vienen del docker-compose.yml.
DATABASE_URL=postgresql://postgres:tu_clave_secreta_aqui@localhost:5432/sst_db

# --- Seguridad / JWT ---
# Clave para firmar los tokens. CAMBIAR en producción.
SECRET_KEY=3ff6a79854b2d1842e2a39c8172bc90aefbf02c8
ALGORITHM=HS256
# Duración del token de acceso en minutos (480 = 8 horas).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Almacenamiento de archivos ---
STORAGE_TYPE=LOCAL
STORAGE_PATH=storage
MAX_UPLOAD_MB=50
